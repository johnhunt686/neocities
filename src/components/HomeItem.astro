---
interface Props {
  width?: string;
  height?: string;
  aspectRatio?: string;
  borderColor?: string;
  borderWidth?: string;
  borderRadius?: string;
}

const {
  width = "100%",
  height = "auto",
  aspectRatio = "1 / 1",
  borderColor = "#000000",
  borderWidth = "10px",
  borderRadius = "10px",
} = Astro.props;
---

<div
  class="home-item"
  style={`--item-width: ${width}; --item-height: ${height}; --item-aspect-ratio: ${aspectRatio}; --item-border-color: ${borderColor}; --item-border-width: ${borderWidth}; --item-border-radius: ${borderRadius};`}
>
  <slot />
</div>

<style>
  .home-item {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    width: var(--item-width);
    height: var(--item-height);
    aspect-ratio: var(--item-aspect-ratio);
    overflow: hidden;
    border: var(--item-border-width) solid var(--item-border-color);
    border-radius: var(--item-border-radius);
  }

  .home-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>