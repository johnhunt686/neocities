---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link href="/Blog/blog.css" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
