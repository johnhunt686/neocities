---
import "../styles/site.css";
import "../styles/transitions.css";
import SiteNav from "../components/SiteNav.astro";

interface Props {
  title?: string;
  sidebar?: boolean;
}

const { title = "DE6K", sidebar = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    {sidebar && <aside class="sidebar"><slot name="sidebar" /></aside>}
    <div class="page-layout">
      <SiteNav />
      <main class="content">
        <slot />
      </main>
    </div>
  </body>
</html>
